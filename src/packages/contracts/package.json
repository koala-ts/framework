{
  "name": "@koala-ts/contracts",
  "version": "2.0.0",
  "description": "Shared contracts for KoalaTs packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koala-ts/contracts.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#contracts/*": {
      "types": "./*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "publint": "publint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "author": {
    "name": "Dhemy",
    "email": "imdhemy@gmail.com",
    "url": "https://imdhemy.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "publint": "^0.3.21",
    "typescript": "^7.0.2"
  }
}
