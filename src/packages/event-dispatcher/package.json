{
  "name": "@koala-ts/event-dispatcher",
  "version": "2.0.0",
  "description": "Event dispatcher component for KoalaTs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koala-ts/framework.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#event-dispatcher/*": {
      "types": "./*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "publint": "publint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "author": {
    "name": "Dhemy",
    "email": "imdhemy@gmail.com",
    "url": "https://imdhemy.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
