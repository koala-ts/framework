{
  "name": "@koala-ts/framework",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "imports": {
    "#koala/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "default": "./dist/routing/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "default": "./dist/validator/index.js"
    },
    "./validator/constraints": {
      "types": "./dist/validator/constraints/index.d.ts",
      "default": "./dist/validator/constraints/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "routing": [
        "dist/routing/index.d.ts"
      ],
      "validator": [
        "dist/validator/index.d.ts"
      ],
      "validator/constraints": [
        "dist/validator/constraints/index.d.ts"
      ]
    }
  },
  "workspaces": [
    "src/packages/*"
  ],
  "description": "A NodeJS framework for lazy developers",
  "keywords": [
    "koala",
    "framework",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://koala-ts.github.io/docs/",
  "bugs": {
    "url": "https://github.com/koala-ts/framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koala-ts/framework.git"
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Dhemy",
    "email": "imdhemy@gmail.com",
    "url": "https://imdhemy.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "build": "npm run build:packages && tsc",
    "build:packages": "npm run build --workspaces --if-present",
    "start": "tsx watch playground/main.ts",
    "check:code": "biome check .",
    "fix:code": "biome check --write .",
    "check:type": "npm run check:type:packages && tsc -p tsconfig.check.json",
    "check:type:packages": "npm run check:type --workspaces --if-present",
    "check:boundaries": "depcruise --validate .dependency-cruiser.cjs src",
    "check:packages": "npm run build:packages && publint src/packages/contracts && node scripts/verify-package-artifact.js src/packages/contracts",
    "watch:test": "vitest watch",
    "watch:build": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@koa/router": "^15.1.1",
    "@koa/send": "^6.0.0",
    "@koala-ts/contracts": "*",
    "@types/koa": "^3.0.0",
    "@types/supertest": "^7.2.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^13.0.0",
    "koa": "^3.0.3",
    "koa-body": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "^4.0.12",
    "dependency-cruiser": "^18.0.0",
    "publint": "^0.3.21",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "^4.0.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
